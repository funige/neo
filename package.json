{
  "name": "paintbbs",
  "version": "1.7.33",
  "main": "app/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funige/neo.git"
  },
  "scripts": {
    "app": "electron .",
    "build": "sh build.sh",
    "check": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/!(lz-string).ts\" \"src/neo.css\" \"sample/*.html\" \"sample2/*.html\"",
    "dev": "sh build.sh watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
