{
  "name": "paintbbs",
  "version": "1.8.11",
  "main": "app/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funige/neo.git"
  },
  "scripts": {
    "app": "electron .",
    "format": "prettier --write \"src/!(lz-string).js\" \"src/neo.css\" \"sample/*.html\" \"sample2/*.html\"",
    "dev": "sh build.sh watch"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "lz-string": "^1.5.0",
    "save-dev": "^0.0.1-security"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
