{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": true
  },
  "files": [
    "src/neo.js",
    "src/container.js",
    "src/dictionary.js",
    "src/painter.js",
    "src/tools.js",
    "src/commands.js",
    "src/actions.js",
    "src/widgets.js",
  ],
  "include": [
    "src/*.*",
    "dist/neo.js"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "Design/*",
    "docs/*",
    "dist/PaintBBS*",
    ".git"
  ]
}
